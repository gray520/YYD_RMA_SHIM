        "target_rpm": [
          3000,
          4500,
          4900
        ],
        "error_margin": 300
      }
    },
    "RRTDozingStress": {
      "label": "Dozing Stress",
      "retries": 5,
      "parallel": true,
      "subtests": [
        {
          "inherit": "StressAppTest",
          "args": {
            "seconds": "eval! constants.run_in.dozing_sat_duration_secs",
            "free_memory_only": true
          }
        },
        {
          "inherit": "SuspendStress",
          "args": {
            "cycles": "eval! constants.run_in.dozing_sat_duration_secs // 60",
            "suspend_delay_min_secs": 25,
            "suspend_delay_max_secs": 30,
            "resume_delay_min_secs": 25,
            "resume_delay_max_secs": 30,
            "pre_suspend_command": "bash /usr/local/factory/sh/debug_suspend.sh Pre_Oper suspend",
            "post_resume_command": "bash /usr/local/factory/sh/debug_suspend.sh Post_Oper suspend"
          }
        },
        {
          "inherit": "RunInCountdown",
          "args": {
            "duration_secs": "eval! constants.run_in.dozing_sat_duration_secs"
          }
        }
      ]
    },
