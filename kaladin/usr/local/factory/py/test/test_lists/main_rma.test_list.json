    "KaladinCopyManifestToCME": {
      "run_if": "device.component.google_name=='kaladin'",
      "pytest_name": "exec_shell",
      "label": "Kaladin Copy Manifest to CME",
      "args": {
        "commands": [
          "mkdir /usr/local/cme -p",
          "mkdir /usr/local/cme/ish -p",
          "mkdir /usr/local/factory/cme -p",
          "mkdir /usr/local/factory/cme/ish -p",
          "cp /usr/local/factory/sh/component_manifest.json /usr/local/cme/component_manifest.json -rf",
          "cp /usr/local/factory/sh/component_manifest.json /usr/local/factory/cme/component_manifest.json -rf",
          "cp /usr/local/factory/sh/component_manifest_kaladin.json /usr/local/cme/ish/component_manifest.json -rf",
          "cp /usr/local/factory/sh/component_manifest_kaladin.json /usr/local/factory/cme/ish/component_manifest.json -rf"
        ]
      }
    },
    "KelsierCopyManifestToCME": {
      "run_if": "device.component.google_name=='kelsier'",
      "pytest_name": "exec_shell",
      "label": "Kelsier Copy Manifest to CME",
      "args": {
        "commands": [
          "mkdir /usr/local/cme -p",
          "mkdir /usr/local/cme/ish -p",
          "mkdir /usr/local/factory/cme -p",
          "mkdir /usr/local/factory/cme/ish -p",
          "cp /usr/local/factory/sh/component_manifest.json /usr/local/cme/component_manifest.json -rf",
          "cp /usr/local/factory/sh/component_manifest.json /usr/local/factory/cme/component_manifest.json -rf",
          "cp /usr/local/factory/sh/component_manifest_lite.json /usr/local/cme/ish/component_manifest.json -rf",
          "cp /usr/local/factory/sh/component_manifest_lite.json /usr/local/factory/cme/ish/component_manifest.json -rf"
        ]
      }
    },
    "CopyISHFWTolib": {
      "pytest_name": "exec_shell",
      "label": "Copy ISH FW To lib",
      "args": {
        "commands": [
          "cp /usr/local/factory/sh/kaladin_ish.bin /lib/firmware/intel/kaladin_ish.bin && sleep 3 && sync",
          "cp /usr/local/factory/sh/lite_ish.bin /lib/firmware/intel/lite_ish.bin && sleep 3 && sync"
        ]
      }
