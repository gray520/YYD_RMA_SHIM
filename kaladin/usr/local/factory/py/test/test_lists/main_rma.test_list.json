    "DeleteVPDFeature": {
      "inherit": "ExecShell",
      "label": "Delete Feature data",
      "args": {
        "commands": "vpd -i RW_VPD -d feature_device_info | true"
      }
    },
    "WriteSSFCForCamera": {
      "inherit": "ExecShell",
      "label": "Write SSFC For Camera",
      "args": {
        "commands": "bash /usr/local/factory/sh/write_ssfc_camera.sh"
      }
    },
    "ClearActivateDate": {
      "inherit": "ExecShell",
      "label": "ClearActivateDate",
      "args": {
        "commands": "activate_date --clean"
      }
    },
