      "args": {
        "challenge": true,
        "target_leds": [
          "BATTERY"
        ],
        "colors": [
          [
            "BATTERY",
            "AMBER"
          ],
          [
            "BATTERY",
            "WHITE"
          ],
          [
            "BATTERY",
